.env

# dns-server
# pihole
dns-server/etc-pihole/*
# unbound
dns-server/unbound/unbound.conf.d/*

# media-server
media-server/data/media/books/*
media-server/data/media/movies/*
media-server/data/media/music/*
media-server/data/media/shows/*
media-server/data/media/anime/*

media-server/data/torrents/books/*
media-server/data/torrents/movies/*
media-server/data/torrents/music/*
media-server/data/torrents/shows/*
media-server/data/torrents/anime-shows/*
media-server/data/torrents/anime-movies/*

media-server/data/usenet/complete/books/*
media-server/data/usenet/complete/movies/*
media-server/data/usenet/complete/music/*
media-server/data/usenet/complete/shows/*
media-server/data/usenet/complete/anime/*
media-server/data/usenet/intermediate/*
media-server/data/usenet/incomplete/*
# jellyfin
media-server/services/jellyfin/config/*
media-server/services/jellyfin/cache/*

# qbittorrent
media-server/services/qbittorrent/appdata/*

# nzbget
media-server/services/nzbget/config/*

# jellyseerr
media-server/services/jellyseerr/appdata/config/*

# sonarr
media-server/services/sonarr/data/*

# radarr
media-server/services/radarr/data/*

# lidarr
media-server/services/lidarr/config/*

# bazarr
media-server/services/bazarr/config/*

# recyclarr
media-server/services/recyclarr/*

# prowlarr
media-server/services/prowlarr/data/*

# vpn-reverse-proxy
# tailscale
vpn-reverse-proxy/tailscale/data/

# nginx-proxy-manager
vpn-reverse-proxy/nginx-proxy-manager/data/*
